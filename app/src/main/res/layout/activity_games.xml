<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bp_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bp_header"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/bp_header"
            android:theme="@style/ThemeOverlay.BP.Toolbar"
            app:title="Bola na TV"
            app:titleMarginStart="16dp"
            app:titleTextAppearance="@style/TextAppearance.BP.Title" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bp_header"
            android:visibility="gone"
            app:tabGravity="start"
            app:tabIndicatorColor="@color/bp_tab_indicator"
            app:tabIndicatorHeight="3dp"
            app:tabMode="scrollable"
            app:tabRippleColor="@null"
            app:tabSelectedTextColor="@color/bp_tab_selected"
            app:tabTextAppearance="@style/TextAppearance.BP.Tab"
            app:tabTextColor="@color/bp_tab_unselected" />

        <LinearLayout
            android:id="@+id/tabs_skeleton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/bp_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="28dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <View android:layout_width="40dp" android:layout_height="12dp"
                    android:background="@drawable/bg_skeleton_header" />
                <View android:layout_width="32dp" android:layout_height="10dp"
                    android:layout_marginTop="6dp" android:background="@drawable/bg_skeleton_header" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="28dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <View android:layout_width="40dp" android:layout_height="12dp"
                    android:background="@drawable/bg_skeleton_header" />
                <View android:layout_width="32dp" android:layout_height="10dp"
                    android:layout_marginTop="6dp" android:background="@drawable/bg_skeleton_header" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="28dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <View android:layout_width="40dp" android:layout_height="12dp"
                    android:background="@drawable/bg_skeleton_header" />
                <View android:layout_width="32dp" android:layout_height="10dp"
                    android:layout_marginTop="6dp" android:background="@drawable/bg_skeleton_header" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <View android:layout_width="40dp" android:layout_height="12dp"
                    android:background="@drawable/bg_skeleton_header" />
                <View android:layout_width="32dp" android:layout_height="10dp"
                    android:layout_marginTop="6dp" android:background="@drawable/bg_skeleton_header" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/skeleton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <include layout="@layout/item_skeleton" />
            <include layout="@layout/item_skeleton" />
            <include layout="@layout/item_skeleton" />
            <include layout="@layout/item_skeleton" />
            <include layout="@layout/item_skeleton" />
            <include layout="@layout/item_skeleton" />
        </LinearLayout>

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:padding="32dp"
            android:text="@string/sem_jogos_de_momento"
            android:textColor="@color/bp_on_surface_muted"
            android:textSize="16sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nao_foi_possivel_carregar"
                android:textColor="@color/bp_on_surface"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/verifica_a_ligacao_internet"
                android:textColor="@color/bp_on_surface_muted"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/tentar_novamente"
                android:textColor="@color/bp_on_accent"
                app:backgroundTint="@color/bp_accent" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/ad_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bp_background" />
</LinearLayout>